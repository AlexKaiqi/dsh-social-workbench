{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/social-workbench/source-bundle.schema.json",
  "title": "SourceBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceId", "origin", "title", "text", "attachments", "rightsNote", "observedAt"],
  "properties": {
    "schemaVersion": { "const": "social-workbench.source/v1" },
    "sourceId": { "type": "string", "pattern": "^source_[a-f0-9]{64}$" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["manual", "file", "authorized-account"] },
        "ref": { "type": "string" }
      }
    },
    "title": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "size", "contentHash"],
        "properties": {
          "kind": { "enum": ["image", "video"] },
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 1 },
          "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "rightsNote": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" }
  }
}
