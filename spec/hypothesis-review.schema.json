{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/social-workbench/hypothesis-review.schema.json",
  "title": "HypothesisReviewV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "planId", "packageId", "briefId", "hypothesis", "verdict", "observations", "metricSnapshotIds", "feedbackIds", "nextBrief", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "social-workbench.hypothesis-review/v1" },
    "reviewId": { "type": "string", "pattern": "^review_[a-f0-9]{64}$" },
    "planId": { "type": "string", "pattern": "^plan_[a-f0-9]{64}$" },
    "packageId": { "type": "string", "pattern": "^package_[a-f0-9]{64}$" },
    "briefId": { "type": "string", "pattern": "^brief_[a-f0-9]{64}$" },
    "hypothesis": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["supported", "mixed", "refuted", "inconclusive"] },
    "observations": { "type": "string", "minLength": 1 },
    "metricSnapshotIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^metric_[a-f0-9]{64}$" } },
    "feedbackIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^feedback_[a-f0-9]{64}$" } },
    "nextBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceIds", "objective", "audience", "coreMessage", "claims", "callToAction", "constraints"],
      "properties": {
        "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^source_[a-f0-9]{64}$" } },
        "objective": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "coreMessage": { "type": "string", "minLength": 1 },
        "claims": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "callToAction": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
