{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/social-workbench/platform-connector.schema.json",
  "title": "PlatformConnectorSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "connectorId", "platform", "generatedAt", "defaultStrategy", "strategies", "providers", "capabilities"],
  "properties": {
    "schemaVersion": { "const": "social-workbench.platform-connector/v1" },
    "connectorId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "platform": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "defaultStrategy": { "$ref": "#/$defs/strategy" },
    "strategies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/strategy" } },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "mode", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "source": { "type": ["string", "null"], "format": "uri" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "summary", "effect", "state", "preferredProviderId", "providers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["none", "local-write", "platform-write"] },
          "state": { "enum": ["available", "degraded", "planned", "unavailable"] },
          "preferredProviderId": { "type": ["string", "null"] },
          "providers": { "type": "array", "items": { "$ref": "#/$defs/providerCapability" } }
        }
      }
    }
  },
  "$defs": {
    "strategy": { "enum": ["balanced", "lowest-cost", "lowest-latency", "widest-coverage", "highest-reliability"] },
    "providerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "providerVersion", "mode", "state", "execution", "authorization", "quality", "coupledCapabilities"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1 },
        "providerVersion": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },
        "state": { "enum": ["available", "degraded", "planned", "unavailable"] },
        "execution": { "enum": ["direct", "coupled", "outbox-only", "not-implemented"] },
        "authorization": { "type": "string", "minLength": 1 },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cost", "latency", "coverage", "reliability"],
          "properties": {
            "cost": { "enum": ["free", "low", "medium", "high", "unknown"] },
            "latency": { "enum": ["fast", "interactive", "batch", "unknown"] },
            "coverage": { "enum": ["selected", "account", "search", "public-platform", "live", "unknown"] },
            "reliability": { "enum": ["experimental", "community", "live-verified", "official", "managed", "unknown"] }
          }
        },
        "coupledCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    }
  }
}
