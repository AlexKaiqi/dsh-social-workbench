{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/social-workbench/publication-result.schema.json",
  "title": "PublicationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["planRef", "itemId", "attempt", "status", "recordedAt"],
  "properties": {
    "planRef": { "type": "string", "minLength": 1 },
    "itemId": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["queued", "submitted", "published", "needs-user-action", "retryable-error", "terminal-error"] },
    "externalId": { "type": "string" },
    "externalUrl": { "type": "string", "format": "uri" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "suggestedAction": { "type": "string" }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "observedAt"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number", "minimum": 0 },
          "observedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "recordedAt": { "type": "string", "format": "date-time" }
  }
}
