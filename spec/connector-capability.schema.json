{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/social-workbench/connector-capability.schema.json",
  "title": "ConnectorCapability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connectorId",
    "platform",
    "mode",
    "lifecycle",
    "capabilities",
    "evidence",
    "checkedAt"
  ],
  "properties": {
    "connectorId": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "accountRef": { "type": "string", "minLength": 1 },
    "credentialRef": { "type": "string", "minLength": 1 },
    "mode": {
      "enum": [
        "official-api",
        "official-feed-export",
        "delegated-service",
        "browser-assisted",
        "manual-handoff",
        "unsupported"
      ]
    },
    "lifecycle": {
      "enum": ["registered-only", "authorized", "callable", "degraded", "revoked"]
    },
    "accountType": { "type": "string" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discover", "read", "search", "publish", "interact", "analytics"],
      "properties": {
        "discover": { "$ref": "#/$defs/capabilityState" },
        "read": { "$ref": "#/$defs/capabilityState" },
        "search": { "$ref": "#/$defs/capabilityState" },
        "publish": { "$ref": "#/$defs/capabilityState" },
        "interact": { "$ref": "#/$defs/capabilityState" },
        "analytics": { "$ref": "#/$defs/capabilityState" }
      }
    },
    "scopes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": { "enum": ["official-doc", "official-sdk", "live-test", "terms", "secondary"] },
          "url": { "type": "string", "format": "uri" },
          "note": { "type": "string" }
        }
      }
    },
    "checkedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "riskTier": { "enum": ["low", "medium", "high", "prohibited"] },
    "notes": { "type": "string" }
  },
  "$defs": {
    "capabilityState": {
      "enum": ["unsupported", "unverified", "authorized-only", "available", "degraded"]
    }
  }
}
