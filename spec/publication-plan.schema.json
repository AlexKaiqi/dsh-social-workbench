{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/social-workbench/publication-plan.schema.json",
  "title": "PublicationPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "packageId", "briefRef", "planHash", "items", "approval", "status", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "social-workbench.publication-plan/v1" },
    "planId": { "type": "string", "pattern": "^plan_[a-f0-9]{64}$" },
    "packageId": { "type": "string", "pattern": "^package_[a-f0-9]{64}$" },
    "briefRef": { "type": "string", "pattern": "^brief_[a-f0-9]{64}$" },
    "planHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "platform", "accountRef", "revisionHash", "deliveryMode", "scheduledAt", "idempotencyKey"],
        "properties": {
          "itemId": { "type": "string", "pattern": "^item_[a-f0-9]{64}$" },
          "platform": { "enum": ["xiaohongshu", "douyin"] },
          "accountRef": { "type": "string", "minLength": 1 },
          "revisionHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "deliveryMode": { "enum": ["official-api", "delegated-service", "browser-assisted", "manual-handoff"] },
          "scheduledAt": { "type": ["string", "null"], "format": "date-time" },
          "idempotencyKey": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "approval": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "const": "pending" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "approvedPlanHash", "approvedBy", "approvedAt", "expiresAt"],
          "properties": {
            "state": { "const": "approved" },
            "approvedPlanHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "approvedBy": { "type": "string", "minLength": 1 },
            "approvedAt": { "type": "string", "format": "date-time" },
            "expiresAt": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "status": { "enum": ["ready", "queued", "manual-action-required", "partially-published", "published", "failed", "cancelled"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
