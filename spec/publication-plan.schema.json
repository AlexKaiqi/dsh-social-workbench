{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/social-workbench/publication-plan.schema.json",
  "title": "PublicationPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "briefRef", "planHash", "items", "approval", "status", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "briefRef": { "type": "string", "minLength": 1 },
    "planHash": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["itemId", "platform", "accountRef", "variantRef", "deliveryMode", "idempotencyKey"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "platform": { "type": "string", "minLength": 1 },
          "accountRef": { "type": "string", "minLength": 1 },
          "variantRef": { "type": "string", "minLength": 1 },
          "deliveryMode": { "enum": ["official-api", "delegated-service", "browser-assisted", "manual-handoff"] },
          "scheduledAt": { "type": "string", "format": "date-time" },
          "idempotencyKey": { "type": "string", "minLength": 1 }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["pending", "approved", "rejected", "expired", "invalidated"] },
        "approvedPlanHash": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "status": { "enum": ["draft", "ready", "queued", "partially-published", "published", "failed", "cancelled"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
