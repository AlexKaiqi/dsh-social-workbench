{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.dev/social-workbench/source-item.schema.json",
  "title": "SourceItemV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "runId", "kind", "source", "externalId", "parentExternalId", "canonicalUrl", "publishedAt", "observedAt", "visibility", "content", "metrics", "mediaArtifactId", "provenance", "privacy"],
  "properties": {
    "schemaVersion": { "const": "social-workbench.source-item/v1" },
    "id": { "type": "string", "pattern": "^sourceitem_[a-f0-9]{64}$" },
    "runId": { "type": "string", "pattern": "^research_[a-f0-9-]{36}$" },
    "kind": { "enum": ["video", "comment"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "connectorId"],
      "properties": {
        "platform": { "const": "douyin" },
        "connectorId": { "const": "mediacrawler-douyin-research" }
      }
    },
    "externalId": { "type": "string", "pattern": "^[0-9]{5,40}$" },
    "parentExternalId": { "type": ["string", "null"], "pattern": "^[0-9]{5,40}$" },
    "canonicalUrl": { "type": "string", "format": "uri", "pattern": "^https://www\\.douyin\\.com/video/" },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "observedAt": { "type": "string", "format": "date-time" },
    "visibility": { "const": "public" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "textKind", "media"],
      "properties": {
        "text": { "type": "string" },
        "textKind": { "enum": ["platform-caption", "comment"] },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "url"],
            "properties": {
              "type": { "const": "video" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "definition"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": "number", "minimum": 0 },
          "definition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mediaArtifactId": { "type": ["string", "null"], "pattern": "^media_[a-f0-9]{64}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessMode", "collector", "collectorCommit", "contentHash", "termsBasis"],
      "properties": {
        "accessMode": { "const": "authenticated-browser-private-api" },
        "collector": { "const": "NanmiCoder/MediaCrawler" },
        "collectorCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "termsBasis": { "type": "string", "minLength": 1 }
      }
    },
    "privacy": { "const": "no-platform-user-identity-retained" }
  }
}
