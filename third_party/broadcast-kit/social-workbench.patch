+def _visibility_label(visibility: str) -> str:
+    labels = {"private": "仅自己可见", "public": "公开"}
+    if visibility not in labels:
+        raise DouyinError(f"unsupported visibility: {visibility}")
+    return labels[visibility]
+
+
+def _visibility_candidate_selected(candidate) -> bool:
+    try:
+        return bool(candidate.evaluate(
+            """el => {
+                const control = el.closest("label, [role='radio'], [role='option'], [role='menuitemradio'], button") || el;
+                const input = control.matches("input") ? control : control.querySelector("input[type='radio'], input[type='checkbox']");
+                if (input && input.checked === true) return true;
+                if (control.getAttribute("aria-checked") === "true" || control.getAttribute("aria-selected") === "true") return true;
+                return false;
+            }"""
+        ))
+    except Exception:
+        return False
+
+
+def _set_visibility(page: Page, visibility: str) -> bool:
+    """Select and prove the requested visibility before submit.
+
+    This deliberately fails closed. Merely seeing the target label is not proof:
+    an accessible checked/selected state must be present after the click.
+    """
+    label = _visibility_label(visibility)
+    candidates = page.get_by_text(label, exact=True)
+    try:
+        for index in range(candidates.count()):
+            candidate = candidates.nth(index)
+            if candidate.is_visible(timeout=400) and _visibility_candidate_selected(candidate):
+                return True
+    except Exception:
+        pass
+
+    # Open the permissions row/dropdown when the target option is not visible.
+    for trigger_text in ("谁可以看", "可见范围", "公开"):
+        try:
+            triggers = page.get_by_text(trigger_text, exact=True)
+            for index in range(triggers.count()):
+                trigger = triggers.nth(index)
+                if not trigger.is_visible(timeout=300):
+                    continue
+                trigger.click(timeout=2500, force=True)
+                page.wait_for_timeout(500)
+                break
+        except Exception:
+            continue
+        try:
+            candidates = page.get_by_text(label, exact=True)
+            if candidates.count() > 0:
+                break
+        except Exception:
+            continue
+
+    try:
+        candidates = page.get_by_text(label, exact=True)
+        for index in range(candidates.count()):
+            candidate = candidates.nth(index)
+            if not candidate.is_visible(timeout=500):
+                continue
+            candidate.click(timeout=3000, force=True)
+            page.wait_for_timeout(800)
+            refreshed = page.get_by_text(label, exact=True)
+            for refreshed_index in range(refreshed.count()):
+                selected = refreshed.nth(refreshed_index)
+                if selected.is_visible(timeout=300) and _visibility_candidate_selected(selected):
+                    return True
+    except Exception:
+        pass
+    return False
+
+
