new file mode 100644
index 0000000..226e9b5
--- /dev/null
+++ b/tests/test_social_workbench_guards.py
@@ -0,0 +1,35 @@
+from pathlib import Path
+from types import SimpleNamespace
+
+from broadcast_kit.commands import doctor
+from broadcast_kit.publishers.douyin import _result_is_confirmed
+from broadcast_kit.publishers.douyin.publish import DouyinError, _visibility_label
+
+
+def test_doctor_respects_state_dir(monkeypatch, tmp_path: Path) -> None:
+    monkeypatch.setenv("BROADCAST_KIT_STATE_DIR", str(tmp_path))
+    report = doctor.run()
+    assert report["state"]["root"] == str(tmp_path.resolve())
+
+
+def test_top_level_success_requires_visibility_and_queue() -> None:
+    base = {
+        "verdict": "success",
+        "cover_verified": True,
+        "visibility_verified": True,
+        "queue_verified": "true",
+    }
+    assert _result_is_confirmed(SimpleNamespace(**base)) is True
+    assert _result_is_confirmed(SimpleNamespace(**{**base, "visibility_verified": False})) is False
+    assert _result_is_confirmed(SimpleNamespace(**{**base, "queue_verified": "partial"})) is False
+
+
+def test_visibility_defaults_are_explicit() -> None:
+    assert _visibility_label("private") == "仅自己可见"
+    assert _visibility_label("public") == "公开"
+    try:
+        _visibility_label("friends")
+    except DouyinError:
+        pass
+    else:
+        raise AssertionError("unsupported visibility must fail closed")
